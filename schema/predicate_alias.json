{
  "\\b(occupation|profession|job|vocation|career)\\b": "occupation",
  "\\b(worked as|served as|held the post of|was an?|is an?)\\s+([A-Za-z- ]+)": "occupation",
  "\\b(spouse|wife|husband|married|partner)\\b": "spouse",
  "\\b(born in|hails from|native of)\\b": "born_in",
  "\\b(born on|date of birth|was born on)\\b": "born_on",
  "\\b(died in|passed away in)\\b": "died_in",
  "\\b(died on|death date|date of death|was killed on)\\b": "died_on",
  "\\b(educated at|alma mater|graduated from|attended)\\b": "educated_at",
  "\\b(wrote|authored|pen(?:ned)?)\\b": "authored_by",
  "\\b(founded|co-founded)\\b": "founded",
  "\\b(founded by|established by)\\b": "founded_by",
  "\\b(works?\\s+for|employed\\s+by)\\b": "works_for",
  "\\b(hired by|was hired by)\\b": "works_for",
  "\\b(sponsored by|sponsored)\\b": "works_for",
  "\\b(member of|affiliated with)\\b": "member_of",
  "\\b(became part of|joined)\\b": "member_of",
  "\\b(travelled with|traveled with)\\b": "member_of",
  "\\b(won|received|awarded)\\b": "award_received",
  "\\b(received from)\\b": "award_received",
  "\\b(judgment in)\\b": "award_received",
  "\\b(held office as|position held)\\b": "position_held",
  "\\b(taught at|teaches at)\\b": "position_held",
  "\\b(took care of|cared for)\\b": "position_held",
  "\\b(performed by|recorded by|artist)\\b": "performed_by",
  "\\b(directed by|directed|who directed)\\b": "directed_by",
  "\\b(acted in|starred in|played|portrayed|starring|cast in)\\b": "acted_in",
  "\\b(headquartered in|headquarters in)\\b": "headquartered_in",
  "\\blocated in\\b": "located_in",
  "\\blabel\\b": "label",
  "\\b(same as|identical to)\\b": "same_as",
  "\\b(alias of|aka|also known as)\\b": "alias_of",
  "\\b(title|position|role|titles)\\b": "title",
  "\\b(category|categories|classification)\\b": "category",
  "\\b(nationality|citizenship|country of citizenship)\\b": "nationality",
  "\\b(type|entity type|category type)\\b": "type",
  "\\b(published by)\\b": "produced_by",
  "\\b(studied|studied at|studied in)\\b": "educated_at",
  "\\b(matriculated|matriculated at|matriculated in)\\b": "educated_at",
  "\\b(tutored by|was tutored by)\\b": "educated_at",
  "\\b(raised by|raised with)\\b": "parent",
  "\\b(moved to|moved into|relocated to)\\b": "residence"
}
